# PostgreSQL root password
POSTGRES_PASSWORD=postgres # Change Me!
# Amass Database
DB_SERVER=postgres         # Optional change to neo4j
AMASS_DB=assetdb
AMASS_USER=amass
AMASS_PASSWORD=amass4OWASP # Change Me!

# Arti (Tor) Proxy: uncomment the line below to route outbound traffic through Tor
# COMPOSE_PROFILES=tor
# DEBUG=1  # Uncomment to enable verbose proxy logging (arti + tor-http-proxy)

# MCP Control Server: set to the absolute host path of this project directory
# Required when COMPOSE_PROFILES includes "mcp"
# PROJECT_DIR=/path/to/amass-docker-compose
# Bearer token for MCP endpoint auth — generate with: openssl rand -hex 32
# If unset, the endpoint has no authentication (local-only use only)
# MCP_API_KEY=

# Caddy Reverse Proxy: add "proxy" to COMPOSE_PROFILES to enable remote HTTPS access
# COMPOSE_PROFILES=mcp,proxy
# DOMAIN=amass.yourdomain.com     # must be a publicly resolvable FQDN for Let's Encrypt
#                                  # use DOMAIN=localhost for local testing (self-signed)
